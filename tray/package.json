{
  "name": "vaultgate",
  "version": "0.3.0",
  "private": true,
  "description": "VaultGate tray companion — runs the obsidian-vaultgate-mcp server with a menu-bar UI.",
  "author": "Mathias Kemeter",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkemeter/obsidian-vaultgate-mcp.git"
  },
  "license": "GPL-3.0-or-later",
  "main": "dist/main.js",
  "scripts": {
    "build:server": "cd ../server && npm run build",
    "bundle:server": "node scripts/copy-server-build.js",
    "bundle:deps": "node scripts/copy-server-deps.js",
    "build:tray": "tsc",
    "build:renderer": "node scripts/copy-renderer.js",
    "download-models": "node scripts/download-models.js",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run build:server && npm run bundle:server && npm run bundle:deps && npm run build:tray && npm run build:renderer",
    "package": "npm run build && electron-builder --mac --dir && node scripts/package-dmg.js",
    "dev": "npm run build && electron .",
    "rebuild": "electron-rebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "knip": "knip",
    "type-coverage": "type-coverage --at-least 98 --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@xenova/transformers": "^2.17.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "knip": "^6.16.1",
    "sharp": "^0.35.3",
    "type-coverage": "^2.30.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "knip": {
    "entry": [
      "src/preload.ts"
    ],
    "project": [
      "src/**/*.ts"
    ],
    "ignoreBinaries": [
      "create-dmg"
    ]
  }
}
